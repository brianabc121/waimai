# Copy to .env. docker compose reads it automatically; for local runs export the values.

# PostgreSQL. In production use a managed database with TLS.
DATABASE_URL=postgres://waimai:waimai@localhost:5432/waimai?sslmode=disable
# Direct (non-pooled) address of the same database. Required when DATABASE_URL
# goes through a transaction-mode pooler (PgBouncer, many managed "pooled"
# endpoints); used for LISTEN and migrations. LISTEN_DATABASE_URL still works.
# DIRECT_DATABASE_URL=

# Secret used to derive order access tokens and hash one-time codes.
# Generate with: openssl rand -hex 32
APP_SECRET=dev-secret-change-me

# true when served over HTTPS (always in production).
COOKIE_SECURE=false

# DEVELOPMENT ONLY: return the phone verification code in the API response
# and show it on the checkout page. Must be false in production.
OTP_DEV_ECHO=true

# Customer-facing origin (https://order.example.com). Used for the order link
# in text messages; without it the messages carry no link.
# PUBLIC_BASE_URL=

# Text messages (verification codes and order updates).
#   log     - write to the server log only (default; development)
#   webhook - POST {"to","message"} as JSON to SMS_WEBHOOK_URL (any local gateway)
#   twilio  - Twilio Programmable Messaging
SMS_PROVIDER=log
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_AUTH=          # sent as the Authorization header
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=               # sender number, or use a messaging service:
# TWILIO_MESSAGING_SERVICE_SID=

# Run background jobs inside the api process (handy for local runs without a separate worker).
EMBED_WORKER=false

# Serve the built frontend from the api process (local runs without Nginx).
# STATIC_DIR=web/dist

ADDR=:8080

# docker compose only
POSTGRES_PASSWORD=waimai
HTTP_PORT=8000

# Google Maps key for the delivery map. Empty turns the map off; the word
# "stub" gives a test map without Google (used by e2e/mapzones.cjs).
GOOGLE_MAPS_API_KEY=

# Server key for the Google Routes API: the planned route of a rider's trip
# (docs/DEPLOY.md, "Google 推荐路线"). Not the browser key above: this one
# must never reach a browser. Empty: planned routes are straight-line
# estimates. "stub" is a stand-in without Google for tests and demos.
GOOGLE_ROUTES_API_KEY=

# Web push for the staff workbench (new delivery reminders in the browser).
# Make a pair with "admin vapid" (docs/DEPLOY.md, "员工工作台"). Empty: no push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the browsers' push services can reach, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Push to the Android app: the Firebase service account, as ONE line of JSON
# in single quotes (docs/DEPLOY.md, "安卓 App"). Empty: the app gets no push.
FCM_SERVICE_ACCOUNT=

# ---- 顾客和商家聊天（OpenIM）----
# 详细步骤见 docs/DEPLOY.md 第 19 节。OPENIM_API_URL 留空就是不开聊天，
# 聊天页会显示“聊天功能暂时没有开通”。
#
# OPENIM_API_URL 按你的跑法二选一：
#   A. 用 docker compose 跑整套（打开 http://localhost:8000）：
#        OPENIM_API_URL=http://openim-server:10002
#      启动：docker compose --profile im up -d --build
#   B. 接口在本机跑（make run），页面用 npm run dev（打开 http://localhost:5173）：
#        OPENIM_API_URL=http://localhost:10002
#      先启动 OpenIM：
#        docker compose -f docker-compose.yml -f deploy/im-local.yml --profile im up -d openim-server
#      make run 不会自动读这个文件，启动接口前要把下面三项 export 出来。
OPENIM_API_URL=

# 下面两项各至少 16 位，用 openssl rand -hex 24 生成，不要用示例值。
OPENIM_SECRET=
OPENIM_HOOK_KEY=

# OpenIM 自己的数据库密码，只在跑法 A 用，第一次启动后再改不生效。
# 例：IM_STORE_PASSWORD=换成你自己的一串字符
IM_STORE_PASSWORD=
