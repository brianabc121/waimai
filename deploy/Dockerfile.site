# Nginx with the built company website (site/, docs/WEBSITE_DESIGN.md).
# Build context is the repository root: the form uses web/src/dial.ts.
FROM node:22-alpine AS build
WORKDIR /repo/site
COPY site/package.json site/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/src/dial.ts /repo/web/src/dial.ts
COPY site ./
# The website's own address and the ordering system's (sign-in, marketplace).
ARG SITE_URL=https://example.com
ARG ORDER_URL=https://order.example.com
ARG PUBLIC_UMAMI_SRC=
ARG PUBLIC_UMAMI_ID=
ENV SITE_URL=$SITE_URL ORDER_URL=$ORDER_URL PUBLIC_UMAMI_SRC=$PUBLIC_UMAMI_SRC PUBLIC_UMAMI_ID=$PUBLIC_UMAMI_ID
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.site.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/site/dist /usr/share/nginx/html
