# Nginx with the built Vue app. Build context is the repository root.
FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web ./
# the server's own texts, listed on the platform's language page (web/vite.config.ts)
COPY internal/app/systexts /internal/app/systexts
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
