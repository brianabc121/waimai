# Production settings for docker compose. Copy to .env in the repository root
# and fill in every value marked CHANGE. Never commit the real .env.

# Database password. Generate with: openssl rand -hex 24
# It is applied when the database volume is first created.
POSTGRES_PASSWORD=CHANGE
# Same password again inside the address. "postgres" is the compose service name.
DATABASE_URL=postgres://waimai:CHANGE@postgres:5432/waimai?sslmode=disable

# Secret for order links, table codes and verification codes.
# Generate with: openssl rand -hex 32. Changing it later invalidates open links.
APP_SECRET=CHANGE

# Your public address, with https and without a trailing slash.
PUBLIC_BASE_URL=https://order.example.com

COOKIE_SECURE=true
OTP_DEV_ECHO=false

# Google Maps key for the delivery map (docs/DEPLOY.md, "Google 地图").
# Empty: delivery areas are a plain list and customers pick an area by name.
GOOGLE_MAPS_API_KEY=

# Server key for the Google Routes API (docs/DEPLOY.md, "Google 推荐路线").
# A separate key, never the browser key above. Empty: planned routes of
# rider trips are straight-line estimates.
GOOGLE_ROUTES_API_KEY=

# Web push for the staff workbench (new delivery reminders in the browser).
# Make a pair with "admin vapid" (docs/DEPLOY.md, "员工工作台"). Empty: no push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the browsers' push services can reach, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Push to the Android app: the Firebase service account, as ONE line of JSON
# in single quotes (docs/DEPLOY.md, "安卓 App"). Empty: the app gets no push.
FCM_SERVICE_ACCOUNT=

# Only the TLS proxy on this host should reach the web container.
HTTP_PORT=127.0.0.1:8000

# Text messages: twilio, webhook, or log (log sends nothing).
SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_AUTH=

# Required when DATABASE_URL goes through a transaction-mode pooler (PgBouncer,
# "pooled" endpoints of managed databases): the direct address of the same
# database. Used for live updates and migrations. See docs/DEPLOY.md section 10.
# DIRECT_DATABASE_URL=
