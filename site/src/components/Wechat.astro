---
// The WeChat ID with a copy button: the one way to reach us brian gave.
import { BRAND } from '../brand'
import { copy, type Lang } from '../i18n'
interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props
const c = copy(lang)
---
<span class="wx" data-testid="wechat"><span class="ic" aria-hidden="true">●</span>{compact ? BRAND.wechat : `${c.common.wechatId} ${BRAND.wechat}`}
  <button type="button" data-copy={BRAND.wechat} data-done={c.common.copied}>{c.common.copy}</button></span>
