---
import Base from '../../layouts/Base.astro'
import Faq from '../../components/Faq.astro'
import Cta from '../../components/Cta.astro'
import Wechat from '../../components/Wechat.astro'
import { copy, href, langPaths, type Lang } from '../../i18n'
export const getStaticPaths = langPaths
const lang = Astro.params.lang as Lang
const c = copy(lang), p = c.pricing
---
<Base lang={lang} title={p.title} description={p.description} path="pricing" page="pricing">
  <div class="phead" style="padding-bottom:110px"><div class="wrap center">
    <h1>{p.h1}</h1><p class="lead">{p.lead}</p>
  </div></div>
  <div class="wrap">
    <div class="plans two">
      <div class="plan best" data-testid="plan-free"><span class="tag">{p.free.for}</span>
        <h3>{p.free.name}</h3><p class="for">&nbsp;</p>
        <div class="price">{p.free.price}</div>
        <ul>{p.free.points.map(x => <li>{x}</li>)}</ul>
        <a class="btn main" href={href(lang, 'demo')}>{p.free.button}</a>
      </div>
      <div class="plan" data-testid="plan-custom">
        <h3>{p.custom.name}</h3><p class="for">{p.custom.for}</p>
        <div class="price ask">{p.custom.price}</div>
        <p class="intro">{p.custom.intro}</p>
        <ul>{p.custom.points.map(x => <li>{x}</li>)}</ul>
        <div style="text-align:center"><Wechat lang={lang} /></div>
      </div>
    </div>
  </div>
  <section style="padding-top:56px"><div class="wrap">
    <h2 class="center">{p.allTitle}</h2>
    <div class="all">{p.all.map(([b, s]) => <div>{b}<span>{s}</span></div>)}</div>
  </div></section>
  <Faq title={p.faqTitle} items={p.faq} />
  <Cta lang={lang} />
</Base>
